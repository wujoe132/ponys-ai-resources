{
  "name": "Ponys.ai multi-ecosystem resource SDK",
  "version": "0.3.0",
  "ecosystems": {
    "npm": {
      "path": "../npm-ponys-ai-resources",
      "package": "ponys-ai-resources"
    },
    "pypi": {
      "path": "python",
      "package": "ponys-ai-resources"
    },
    "rubygems": {
      "path": "ruby",
      "package": "ponys-ai-resources"
    },
    "packagist": {
      "path": "php",
      "package": "ponys-ai/resources"
    },
    "crates.io": {
      "path": "rust",
      "package": "ponys-ai-resources"
    },
    "go": {
      "path": "go",
      "package": "github.com/wujoe132/ponys-ai-resources/packages/go"
    }
  },
  "policy": "Useful official SDKs only; no hidden links or automatic injection."
}
